# Copy to .env and fill in real values. .env is git-ignored.
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatbooking
DB_USER=seatbooking
DB_PASSWORD=change-me
DB_POOL_SIZE=20
# disable | prefer | require. Use require for Render's external hostname.
DB_SSL_MODE=prefer

# Auth
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_TTL=1h
AUTH_DEV_TOKEN_ENABLED=true
ADMIN_SECRET=change-me

# Logging: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Overload protection (defaults shown). Raise MAX_CONCURRENT_REQUESTS with CPU, not with traffic.
# MAX_CONCURRENT_REQUESTS=32
# REQUEST_QUEUE_TIMEOUT=30s
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_LOCK_TIMEOUT_MS=3000
# SOLD_SEAT_CACHE_TTL=10s
